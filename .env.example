# Copy to .env to override defaults
PORT=4800
# HOST and TRUST_PROXY override Settings → Network · HTTPS mode (off: 0.0.0.0 and no proxy; on: 127.0.0.1 and TRUST_PROXY=1).
# Leave them unset to switch from the Settings window.
# Bind address: 0.0.0.0 = reachable from other computers; 127.0.0.1 = this machine only
# HOST=0.0.0.0
# Behind the HTTPS proxy (deploy/Caddyfile, README "Serving over HTTPS"): HOST=127.0.0.1 and TRUST_PROXY=1 (honour
# X-Forwarded-* from a proxy on this host; or a comma-separated list of proxy IPs/CIDRs). Unset = forwarded headers ignored.
# TRUST_PROXY=1
PGHOST=localhost
PGPORT=5432
PGDATABASE=agentapp
PGUSER=agentuser
PGPASSWORD=agentuser
# Optional: Anthropic API models use it, and Claude Code runs authenticate with it instead of the claude CLI login.
# For the systemd service prefer /etc/agentforge/agentforge.env (0600, README "Anthropic API key") over this file.
# ANTHROPIC_API_KEY=
# Optional: OpenRouter models (Model Manager → Add model → OpenRouter) use it. Not passed to agents. Prefer the same
# /etc/agentforge/agentforge.env file for the systemd service (README "OpenRouter").
# OPENROUTER_API_KEY=
# Optional: Groq models (Model Manager → Add model → Groq) use it. Not passed to agents. Same file advice (README "Groq").
# GROQ_API_KEY=
# Optional: Mistral models (Model Manager → Add model → Mistral) use it. Not passed to agents. Same file advice (README "Mistral").
# MISTRAL_API_KEY=
# Optional: Cohere models (Model Manager → Add model → Cohere) use it. Not passed to agents. Same file advice (README "Cohere").
# COHERE_API_KEY=
# Optional: SambaNova Cloud models (Model Manager → Add model → SambaNova) use it. Not passed to agents. Same file advice (README "SambaNova").
# SAMBANOVA_API_KEY=
# Optional: make this account an active administrator on every boot (created if missing when a password is given).
# AF_ADMIN_USERNAME=
# AF_ADMIN_PASSWORD=
