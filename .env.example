# Copy to .env to override defaults
PORT=4800
# Bind address: 0.0.0.0 (default) = reachable from other computers; 127.0.0.1 = this machine only
# HOST=0.0.0.0
# Behind the HTTPS proxy (deploy/Caddyfile, README "Serving over HTTPS"): HOST=127.0.0.1 and TRUST_PROXY=1 (honour
# X-Forwarded-* from a proxy on this host; or a comma-separated list of proxy IPs/CIDRs). Unset = forwarded headers ignored.
# TRUST_PROXY=1
PGHOST=localhost
PGPORT=5432
PGDATABASE=agentapp
PGUSER=agentuser
PGPASSWORD=agentuser
# Optional: used by the "Anthropic API" model provider
# ANTHROPIC_API_KEY=
# Optional: make this account an active administrator on every boot (created if missing when a password is given).
# AF_ADMIN_USERNAME=
# AF_ADMIN_PASSWORD=
